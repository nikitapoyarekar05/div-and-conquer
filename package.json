{
    "name": "div-and-conquer",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "lint-fix": "eslint --fix",
        "format": "prettier --write",
        "format-fix": "prettier --write",
        "format-check": "prettier --check",
        "type-check": "tsc --noEmit",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "next": "16.3.5",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.7.0",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "^9",
        "eslint-config-next": "16.3.5",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "^27.0.1",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6",
        "typescript": "^5",
        "vitest": "^3.2.7"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    }
}
